# ===== 服务 =====
PORT=8787
WORKSPACE_ROOT=./workspace

# ===== LLM（至少填一组）=====
# 支持 openai / deepseek 等 LangChain ChatOpenAI 兼容 provider；可配 LLM_BASE_URL 指向中转或本地
LLM_PROVIDER=openai
LLM_API_KEY=your-key-here
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ===== 基建（docker compose）=====
# PG（base compose 提供；宿主机 5433，避免与本机原生 PG 冲突）
DATABASE_URL=postgresql+asyncpg://zeffy:zeffy@localhost:5433/zeffy_workplace
# Redis（base compose 提供；宿主机 6380）
REDIS_URL=redis://localhost:6380
# Qdrant（vector compose 提供，P1 才启用，P0 无需连接）
QDRANT_URL=http://localhost:6333

# ===== 可观测（P3 启用）=====
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# ===== 上下文压缩（P1 启用）=====
# CONTEXT_MAX_ROUNDS=30
# CONTEXT_MAX_TOKENS=8000

# ===== 运行时覆盖（可选，不固定在此）=====
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=2048